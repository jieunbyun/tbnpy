{
  "name": "ABCDE",
  "description": "The ABCDE toy network of s1_define_model.py, written declaratively. Compiling it gives the same model as the hand-written classes c.py, oc.py and e.py.",
  "variables": [
    {"name": "A", "kind": "discrete", "states": [-0.3, 0.3], "meaning": "first additive shift"},
    {"name": "B", "kind": "discrete", "states": [-0.2, 0.0, 0.2], "meaning": "second additive shift"},
    {"name": "C", "kind": "continuous", "meaning": "the quantity of interest"},
    {"name": "OC", "kind": "continuous", "meaning": "a noisy observation of C"},
    {"name": "D", "kind": "discrete", "states": [0, 1], "meaning": "gate: 0 passes C through to E, 1 blocks it"},
    {"name": "E", "kind": "continuous", "meaning": "C when the gate is open, otherwise 0"}
  ],
  "nodes": [
    {"name": "A", "type": "discrete_cpt", "parents": [], "probabilities": [0.5, 0.5]},
    {"name": "B", "type": "discrete_cpt", "parents": [], "probabilities": [0.3, 0.4, 0.3]},
    {"name": "C", "type": "distribution", "parents": ["A", "B"], "family": "normal",
     "parameters": {"loc": "A + B", "scale": "0.6"},
     "meaning": "C | A, B ~ Normal(A + B, 0.6^2)"},
    {"name": "OC", "type": "distribution", "parents": ["C"], "family": "normal",
     "parameters": {"loc": "C", "scale": "0.5"},
     "meaning": "OC | C ~ Normal(C, 0.5^2)"},
    {"name": "D", "type": "discrete_cpt", "parents": [], "probabilities": [0.4, 0.6]},
    {"name": "E", "type": "equation", "parents": ["C", "D"], "equation": "If(D == 0, C, 0)",
     "meaning": "E = C if D == 0, else 0"}
  ],
  "analysis": {
    "query_nodes": ["C", "E"],
    "observed_nodes": ["OC"],
    "notes": "Condition on OC with tbnpy.inference.sample_evidence; E is deterministic, so observe OC rather than E."
  }
}
